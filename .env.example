# SHELTERLINK X Environment Configuration
# Copy this file to .env and adjust variables as needed

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=shelterlink-x-insecure-dev-secret-change-in-production-2026

# Database URI (SQLite for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///instance/shelterlink.db
# Example PostgreSQL URL for cloud deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/shelterlink_db

# Security & Sessions
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=120

# Machine Learning & Forecasting
MODEL_CACHE_DIR=instance/models
DEFAULT_FORECAST_HORIZON_HOURS=6

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/shelterlink.log
